# Copiar a .env en cada app que lo necesite (apps/api, packages/database)
# y completar con las credenciales reales. Nunca commitear el .env real.

# --- Base de datos (Supabase Postgres) ---
# Sacar la cadena de conexión de: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Usar el "Connection pooling" (puerto 6543) para la app y el directo (5432) para migraciones.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Redis (locks temporales de slots durante checkout) ---
# Opción gratuita: Upstash Redis (https://upstash.com)
REDIS_URL="redis://default:[PASSWORD]@[HOST]:6379"

# --- API ---
PORT=3103
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
# URLs permitidas para CORS/WebSocket, separadas por coma. En local no hace
# falta (cae a localhost:3101/3102); en producción, las URLs de Netlify:
# ALLOWED_ORIGINS="https://aurora-beauty-cliente.netlify.app,https://aurora-beauty-admin.netlify.app"
ALLOWED_ORIGINS=""

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Pagos (Yape/Plin manual — sin pasarela, confirmación manual por recepción) ---
PAYMENT_YAPE_PLIN_PHONE="942774205"
PAYMENT_YAPE_PLIN_HOLDER="Vincenzo Alessandro Cruces Ugarte"
PAYMENT_DEPOSIT_CENTS=2000

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:3103"
