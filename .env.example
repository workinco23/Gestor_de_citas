# Copiar a .env en cada app que lo necesite (apps/api, packages/database)
# y completar con las credenciales reales. Nunca commitear el .env real.

# --- Base de datos (Supabase Postgres) ---
# Sacar la cadena de conexión de: Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Usar el "Connection pooling" (puerto 6543) para la app y el directo (5432) para migraciones.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Redis (locks temporales de slots durante checkout) ---
# Opción gratuita: Upstash Redis (https://upstash.com)
REDIS_URL="redis://default:[PASSWORD]@[HOST]:6379"

# --- API ---
PORT=3103
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Pagos (Culqi) ---
CULQI_PUBLIC_KEY=""
CULQI_SECRET_KEY=""

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:3103"
